# Environment Variables — Copy to .env and fill in your values

# ─── Database ───────────────────────────────────────────────────────────────
POSTGRES_USER=aicmp
POSTGRES_PASSWORD=aicmp_secret
POSTGRES_DB=ai_cmp

# ─── Application ────────────────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_long_random_string_in_production
ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Redis / Celery ─────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── AI Provider ────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ─── File Storage ───────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf,text/plain

# ─── SLA Settings ───────────────────────────────────────────────────────────
SLA_HOURS_DEFAULT=72
SLA_HOURS_HIGH_PRIORITY=24
SLA_HOURS_CRITICAL=8

# ─── Escalation ─────────────────────────────────────────────────────────────
ESCALATION_CHECK_INTERVAL_MINUTES=30
